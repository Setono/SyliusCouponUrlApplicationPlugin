{# @var data \Sylius\Component\Core\Model\PromotionCouponInterface #}
{% import '@SyliusAdmin/shared/helper/button.html.twig' as button %}

<div data-bs-toggle="tooltip" data-bs-title="{{ action.label|trans }}">
    {{ button.default({
        icon: action.icon|default('tabler:link'),
        icon_only: true,
        text: action.label|trans,
        attr: 'data-bs-toggle=modal data-bs-target=#setono-coupon-url-modal data-coupon-code=' ~ data.code,
    }) }}
</div>

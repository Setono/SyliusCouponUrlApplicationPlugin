{% set default_base_url = url('sylius_shop_homepage') %}

<div class="modal fade"
     id="setono-coupon-url-modal"
     tabindex="-1"
     aria-labelledby="setono-coupon-url-modal-title"
     aria-hidden="true"
     data-default-base-url="{{ default_base_url }}"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="setono-coupon-url-modal-title">
                    {{ 'setono_sylius_coupon_url_application.ui.modal.title'|trans }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'sylius.ui.close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="setono-coupon-url-modal-base-url">
                        {{ 'setono_sylius_coupon_url_application.ui.modal.base_url'|trans }}
                    </label>
                    <input type="url" class="form-control" id="setono-coupon-url-modal-base-url" value="{{ default_base_url }}">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="setono-coupon-url-modal-url">
                        {{ 'setono_sylius_coupon_url_application.ui.modal.url'|trans }}
                    </label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" id="setono-coupon-url-modal-url" readonly>
                        <button type="button" class="btn btn-outline-secondary" id="setono-coupon-url-modal-copy">
                            {{ ux_icon('tabler:copy') }}
                            <span class="ms-1">{{ 'setono_sylius_coupon_url_application.ui.modal.copy'|trans }}</span>
                        </button>
                    </div>
                    <div class="form-text d-none" id="setono-coupon-url-modal-copy-feedback">
                        {{ 'setono_sylius_coupon_url_application.ui.modal.copied'|trans }}
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    {{ 'sylius.ui.close'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>
